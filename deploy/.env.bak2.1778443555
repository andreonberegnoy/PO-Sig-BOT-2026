# ==============================================================================
# Production env-vars for VPS deployment. Copy to .env and fill in real values.
# All values are pulled from Railway Variables — values match what's set there.
# ==============================================================================

# ─── Pocket Option authentication (REQUIRED) ──────────────────────────────────
# Session cookie. Get via tools/make_storage_state.py and extract from state.json
PO_SSID=f64be2b0a4a28ab1d9c91ced629d9118
# Account ID. Visible in PO cabinet URL or in state.json
PO_UID=112748554
# 1 = demo, 0 = real. Must match the account used to capture PO_SSID
PO_IS_DEMO=0

# ─── Auto-relogin via Playwright (REQUIRED for stability) ─────────────────────
# Base64-encoded state.json. Generate locally:
#   python3 tools/make_storage_state.py
#   base64 -i state.json | tr -d '\n'
PO_STORAGE_STATE_

# ─── Telegram bot (REQUIRED) ──────────────────────────────────────────────────
# From @BotFather
TELEGRAM_TOKEN=8694979565:AAF1Q1md6tFakhgs1ekt7M38HkCGOBaHpVw
# Your personal chat ID (from @userinfobot)
TELEGRAM_CHAT_ID=554664556

# ─── Optional: PO endpoint pinning ────────────────────────────────────────────
# When set, bot stays on this URL even if PO suggests another region.
# Has a circuit breaker — surrenders to PO's choice after 3 auth failures.
# Leave empty to use whatever PO routes to (recommended for VPS).
# PO_PREFERRED_WS_URL=wss://api-eu.po.market/socket.io/?EIO=4&transport=websocket

# ─── Optional: Relogin frequency (default 12h) ────────────────────────────────
# PO_RELOGIN_HOURS=12

# ─── Optional: API port (default 8080) ────────────────────────────────────────
# PORT=8080
PO_PREFERRED_WS_URL=wss://api-eu.po.market/socket.io/?EIO=4&transport=websocket

# Static residential proxy via Proxy-Cheap (Lumina Broadband, Finland)
